table _measure
	lineageTag: 29d02199-d1eb-4a4b-bc32-af8a8a24c610

	measure 'Total Refreshes' = COUNTROWS(fact_refresh)
		formatString: 0
		lineageTag: 97533b39-7874-4715-84ee-ce60dcef41c3

	measure 'Failed Refreshes' = CALCULATE(COUNTROWS(fact_refresh), fact_refresh[is_failure] = TRUE)
		formatString: 0
		lineageTag: 6efc2de8-2b79-4673-b73d-e2c5b1f64ae4

	measure 'Success Rate %' = DIVIDE(CALCULATE(COUNTROWS(fact_refresh), fact_refresh[is_failure] = FALSE), [Total Refreshes]) * 100
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9a015120-53d0-473c-887d-6a3522f61cb7

	measure 'Avg Duration (s)' = AVERAGE(fact_refresh[duration_seconds])
		lineageTag: 798ef8f1-5130-4366-ac86-f2b8e6736720

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Days Since Refresh' =
			
			VAR LastSuccess = CALCULATE(MAX(fact_refresh[end_time]), fact_refresh[is_failure] = FALSE, ALLSELECTED(fact_refresh))
			RETURN DATEDIFF(LastSuccess, NOW(), DAY)
		formatString: 0
		lineageTag: 67bff818-153f-4f3b-9d11-35cd22831e33

	measure 'Failed Refreshes Color' = ```
			IF([Failed Refreshes] > 0, "#C76A5F", "#45B499")
			
			```
		lineageTag: 1326cae5-d2af-430a-855c-36ca363782df

	measure 'Refresh Success Rate Color' =
			
			IF([Success Rate %] >= 90, "#45B499", IF([Success Rate %] >= 70, "#DCB35A", "#C76A5F"))
		lineageTag: c7960923-cb73-427e-9b65-2853600e34da

	measure 'Distinct Publishers' = DISTINCTCOUNT(fact_activity[user_id])
		formatString: 0
		lineageTag: 7f35d7f3-6f98-45a4-99c3-1aa8ed669e87

	measure 'Total Items' = COUNTROWS(dim_item)
		formatString: 0
		lineageTag: 59390a7c-fdec-452d-86fd-f26db41df565

	measure Compute = CALCULATE(COUNTROWS(dim_item), dim_item[item_type] IN {"Notebook", "DataPipeline"})
		formatString: 0
		lineageTag: c72d2577-3eb5-4325-83c5-f2f9bfd701ed

	measure Data = CALCULATE(COUNTROWS(dim_item), dim_item[item_type] IN {"Lakehouse", "SQLEndpoint", "Warehouse", "SQLDatabase"})
		formatString: 0
		lineageTag: d1bfa6f0-c586-4cf1-8814-8a12efbc0019

	measure Presentation = CALCULATE(COUNTROWS(dim_item), dim_item[item_type] IN {"Report", "SemanticModel", "App"})
		formatString: 0
		lineageTag: 200dd5f1-9717-420e-bf13-96bc13dee70d

	measure 'Total CU (Item Trend)' = SUM(fact_capacity_consumption[sum_cu])
		lineageTag: 9c31cfd3-a87b-4096-809b-c2f76155600a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total CU' = SUM(fact_capacity_utilization[sum_cu])
		lineageTag: bdb9ab78-3400-4805-8965-3b86b4288f7a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total CU (Item, by Date)' =
			
			CALCULATE(SUM(fact_capacity_consumption[sum_cu]), USERELATIONSHIP(fact_capacity_consumption[date_id], dim_date[date_id]))
		lineageTag: 35cea99c-b633-4797-a0e6-6225e66b4a25

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Daily CU' = AVERAGE(fact_capacity_utilization[sum_cu])
		lineageTag: f9f95683-64f7-453b-b156-f9626f198f5c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Interactive %' =
			
			VAR LatestDate = MAX(fact_capacity_utilization[date_id])
			VAR Inter = CALCULATE(SUM(fact_capacity_utilization[avg_interactive]), fact_capacity_utilization[date_id] = LatestDate)
			VAR Back = CALCULATE(SUM(fact_capacity_utilization[avg_background]), fact_capacity_utilization[date_id] = LatestDate)
			RETURN DIVIDE(Inter, Inter + Back) * 100
		lineageTag: dc21cf7b-3cb4-4af2-866e-0441191a60de

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Background %' = 100 - [Interactive %]
		lineageTag: 245ce243-27c2-40eb-b0cc-5dc3f936325f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CU % of Base' = DIVIDE(AVERAGE(fact_capacity_utilization[avg_cu]), AVERAGE(fact_capacity_utilization[base_capacity_units])) * 100
		lineageTag: 98770c2b-c09b-48a7-bf3d-9350885eeae6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Monthly Cost (USD)' = 7776
		formatString: 0
		lineageTag: 80e1670a-26b3-4e01-a84d-c2ca5e8db7e9

	measure 'Idle Cost (USD)' = [Monthly Cost (USD)] * (100 - [CU % of Base]) / 100
		lineageTag: d852d89e-5b5a-4f76-891e-d12e371fb887

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tracked Items' = COUNTROWS(fact_item_lifecycle)
		formatString: 0
		lineageTag: c952b728-21b8-49af-865e-b5da6390848d

	measure 'Active Items' = CALCULATE(COUNTROWS(fact_item_lifecycle), fact_item_lifecycle[lifecycle_status] = "Active")
		formatString: 0
		lineageTag: 9ee804aa-6556-4a59-a230-37f2bdce4eaa

	measure 'Inactive Items' = CALCULATE(COUNTROWS(fact_item_lifecycle), fact_item_lifecycle[lifecycle_status] = "Inactive")
		formatString: 0
		lineageTag: dd1b186d-c67a-476b-ad99-67ba56cd8a47

	measure 'Cleanup Candidates' = CALCULATE(COUNTROWS(fact_item_lifecycle), fact_item_lifecycle[lifecycle_status] = "Cleanup Candidate")
		formatString: 0
		lineageTag: e8bd26bb-9913-48d2-910c-76206a7659f6

	measure 'No Signal Items' = CALCULATE(COUNTROWS(fact_item_lifecycle), fact_item_lifecycle[lifecycle_status] = "No Activity Recorded")
		formatString: 0
		lineageTag: a2d578f9-54ee-494c-99bc-d7a1b63931bc

	measure 'Projected Saturation Date' = SELECTEDVALUE(capacity_planning_summary[projected_saturation_date])
		formatString: General Date
		lineageTag: 7c3e9a1d-5f8b-4c2a-9d6e-1b7f3a5c9e54

	measure 'Weeks to Saturation' = SELECTEDVALUE(capacity_planning_summary[weeks_to_saturation])
		lineageTag: 2a8d5f3c-9b1e-4a7d-8c3f-6e2b9d5a1f56

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Current Headroom %' = SELECTEDVALUE(capacity_planning_summary[current_headroom_pct])
		lineageTag: 9f3c7e1a-4d8b-4f2c-9a6e-3b1d7f9c5a58

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weekly CU Growth %' = SELECTEDVALUE(capacity_planning_summary[growth_pct_per_week])
		lineageTag: 5e1b8c3f-7a2d-4e9c-8b1f-3a5c7e1b9d60

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Confidence' =

			VAR Confidence = SELECTEDVALUE(capacity_planning_summary[forecast_confidence])
			VAR Caveat = SELECTEDVALUE(capacity_planning_summary[confidence_caveat])
			RETURN Confidence & " — " & Caveat
		lineageTag: 8d2f6a9c-3e7b-4d1f-9c8a-2e6b9d3f7c62

	column Column
		isHidden
		formatString: 0
		lineageTag: 9c7e3885-42d6-43d5-9e7f-2a4535604bb8
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _measure = calculated
		mode: import
		source = ROW("Column", BLANK())

	annotation PBI_Id = 5743bcd637044cd5b364e245c1fed631

