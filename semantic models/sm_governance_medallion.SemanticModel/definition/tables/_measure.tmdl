table _measure
	lineageTag: 27316928-2317-4dee-a1ba-3c288a5e8d80

	measure 'Total Refreshes' = ```
			
			COUNTROWS(fact_refresh)
			
			```
		formatString: 0
		lineageTag: ea72af87-8591-45f8-9300-8b2557ebdb70

	measure 'Failed Refreshes' = ```
			
			CALCULATE(COUNTROWS(fact_refresh), fact_refresh[is_failure] = TRUE)
			
			```
		formatString: 0
		lineageTag: 692c2389-115a-4bd9-abd8-48e56ab20fdd

	measure 'Success Rate %' = ```
			
			DIVIDE(
			    CALCULATE(COUNTROWS(fact_refresh), fact_refresh[is_failure] = FALSE),
			    [Total Refreshes]
			) * 100
			
			```
		formatString: 0.0"%"
		lineageTag: f0ed1d84-2b33-419e-8a87-8659a13af328

	measure 'Avg Duration (s)' = ```
			
			AVERAGE(fact_refresh[duration_seconds])
			
			```
		formatString: #,0.0
		lineageTag: 0856e1d4-1f2c-4bcc-8924-b47d1c34643a

	measure 'Distinct Publishers' = ```
			
			DISTINCTCOUNT(fact_activity[user_id])
			
			```
		formatString: 0
		lineageTag: ca0eaba2-78f5-4979-b62c-7f3164c84cf8

	measure 'Days Since Refresh' = ```
			
			VAR LastSuccess =
			    CALCULATE(
			        MAX(fact_refresh[end_time]),
			        fact_refresh[is_failure] = FALSE,
			        ALLSELECTED(fact_refresh)
			    )
			RETURN
			    DATEDIFF(LastSuccess, NOW(), DAY)
			
			```
		formatString: 0
		lineageTag: e4d75a14-939e-464c-8378-8b913151df83

	measure 'Total CU (Item Trend)' = SUM(fact_capacity_consumption[sum_cu])
		lineageTag: 844619fc-f0cf-4cf1-934f-f466d2fca4b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total CU' = SUM(fact_capacity_utilization[sum_cu])
		lineageTag: 901eb85d-a518-4b84-ba62-186629854260

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total CU (Item, by Date)' =
			
			CALCULATE(
			    SUM(fact_capacity_consumption[sum_cu]),
			    USERELATIONSHIP(fact_capacity_consumption[date_id], dim_date[date_id])
			)
		lineageTag: a38b524b-8744-4214-9bc9-6cdb487ae8a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Daily CU' = AVERAGE(fact_capacity_utilization[sum_cu])
		lineageTag: fbc18550-3d01-48a3-a757-3f8a6bb2d036

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Items' = COUNTROWS(dim_item)
		formatString: 0
		lineageTag: 77d54761-ccee-4c90-8533-f44112dbc6ef

	measure Compute = CALCULATE(COUNTROWS(dim_item), dim_item[item_type] IN {"Notebook", "DataPipeline"})
		formatString: 0
		lineageTag: 15c99b52-53d1-4300-9ae8-a0eb2a31fc84

	measure Data = CALCULATE(COUNTROWS(dim_item), dim_item[item_type] IN {"Lakehouse", "SQLEndpoint", "Warehouse", "SQLDatabase"})
		formatString: 0
		lineageTag: 92f38eed-313f-4ec2-9a78-e8499a398104

	measure Presentation = CALCULATE(COUNTROWS(dim_item), dim_item[item_type] IN {"Report", "SemanticModel", "App"})
		formatString: 0
		lineageTag: 8047be60-de2c-4b79-9559-9e3e0f0aa5eb

	measure 'Interactive %' =
			
			VAR LatestDate = MAX(fact_capacity_utilization[date_id])
			VAR Inter = CALCULATE(SUM(fact_capacity_utilization[avg_interactive]), fact_capacity_utilization[date_id] = LatestDate)
			VAR Back = CALCULATE(SUM(fact_capacity_utilization[avg_background]), fact_capacity_utilization[date_id] = LatestDate)
			RETURN DIVIDE(Inter, Inter + Back) * 100
		lineageTag: dfba4f17-fca1-4abd-8568-27d4281652e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Background %' = 100 - [Interactive %]
		lineageTag: d10157bd-bb27-4b1d-8571-9a75cf598158

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CU % of Base' = DIVIDE(AVERAGE(fact_capacity_utilization[avg_cu]), AVERAGE(fact_capacity_utilization[base_capacity_units])) * 100
		lineageTag: 20d3ce5c-e46b-4683-b152-8f62535f4dc6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Failed Refreshes Color' = IF([Failed Refreshes] > 0, "#C76A5F", "#45B499")
		lineageTag: 458b4007-c7e5-40b5-9afd-dadf527ec113

	measure 'Refresh Success Rate Color' =
			
			IF(
			    [Success Rate %] >= 90, "#45B499",
			    IF([Success Rate %] >= 70, "#DCB35A", "#C76A5F")
			)
		lineageTag: b95e3439-3514-459a-88a4-529ea2439c70

	measure 'Tracked Items' = COUNTROWS(fact_item_lifecycle)
		formatString: 0
		lineageTag: 434cba1b-cb78-4c18-8d83-f6d1c72da354

	measure 'Active Items' = CALCULATE(COUNTROWS(fact_item_lifecycle), fact_item_lifecycle[lifecycle_status] = "Active")
		formatString: 0
		lineageTag: 9577f26a-2373-4649-95bd-dda1dceb2b37

	measure 'Inactive Items' = CALCULATE(COUNTROWS(fact_item_lifecycle), fact_item_lifecycle[lifecycle_status] = "Inactive")
		formatString: 0
		lineageTag: 0ca5bee6-a533-444e-8799-4c05f7f6ef7b

	measure 'Cleanup Candidates' = CALCULATE(COUNTROWS(fact_item_lifecycle), fact_item_lifecycle[lifecycle_status] = "Cleanup Candidate")
		formatString: 0
		lineageTag: f9fb558b-bbde-416f-9fe5-7b6f36d77615

	measure 'No Signal Items' = CALCULATE(COUNTROWS(fact_item_lifecycle), fact_item_lifecycle[lifecycle_status] = "No Activity Recorded")
		formatString: 0
		lineageTag: f2c8b0ab-675a-43a0-8a33-66cdd68d27bd

	measure 'Monthly Cost (USD)' = 7776
		formatString: 0
		lineageTag: af638d84-856a-47e2-bfe3-5f8b84691c79

	measure 'Idle Cost (USD)' = [Monthly Cost (USD)] * (100 - [CU % of Base]) / 100
		lineageTag: 33af6aab-4f6d-4eb9-833a-817869cf96e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column
		formatString: 0
		lineageTag: 5214aca8-d595-406e-9334-b4a427bdd0f7
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _measure = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 8f6c1f0b6dfb4e6c9f9c1a2b3c4d5e6f

